  <section|附录>

  <subsection|数据处理代码>

  线性拟合

  <\scm-code>
    import numpy as np

    import matplotlib.pyplot as plt

    x=np.arange(1,9,1)

    y=np.array([0.74, 1.41, 2.11, 2.78, 3.42, 4.08, 4.75, 5.36])

    #一元线性拟合（deg=1）y=ax+b

    coefficients=np.polyfit(x,y,1)

    a,b=coefficients[0],coefficients[1]

    print(a)
  </scm-code>

  结果：

  <\scm-code>
    0.6617857142857143
  </scm-code>

  作图：

  <\scm-code>
    #绘制原始数据：

    plt.rcParams['font.sans-serif']=['SimHei']

    plt.figure(figsize=(8,6))

    plt.scatter(x,y,color='blue',label='原始数据')

    plt.yticks(ticks=[i/2 for i in range(0, 12)],

    \ \ \ \ \ \ \ \ \ \ \ labels=[f'{i/2}' for i in range(0, 12)])

    \;

    #绘制拟合直线：

    x_fit=np.linspace(1,8,2)

    y_fit=a*x_fit+b

    plt.plot(x,y,color='red',label='拟合直线')

    \;

    plt.title('b-m关系最小二乘拟合')

    plt.xlabel('砝码质量m(kg)')

    plt.ylabel('标尺读数b(cm)')

    \;

    plt.legend()

    plt.show()
  </scm-code>

